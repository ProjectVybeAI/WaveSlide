# WaveSlide engine settings. `npm run setup` copies this file to .env if it is missing.
# No secrets exist in this project.
WAVESLIDE_PORT=8765
WAVESLIDE_UI_ORIGIN=http://localhost:5173
WAVESLIDE_DATA_DIR=./data
# camera = real webcam; replay = a recorded or synthetic landmark session (no webcam needed)
WAVESLIDE_SOURCE=camera
WAVESLIDE_REPLAY_SESSION=synthetic-demo
# pyautogui = real key presses; record = keys are only logged (tests, replay demos)
WAVESLIDE_KEYS=pyautogui
WAVESLIDE_LOG_LEVEL=info
